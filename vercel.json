{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/_shell.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/_shell.html"
    },
    {
      "source": "/crm",
      "destination": "/_shell.html"
    },
    {
      "source": "/crm/:path*",
      "destination": "/_shell.html"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
