/* FILE: src/index.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: auto;
    scroll-padding-top: 5.5rem;
    background-color: #06080f;
    color: #f8fafc;
    overflow-x: hidden;
    width: 100%;
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    letter-spacing: -0.015em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
    width: 100%;
    min-height: 100vh;
    background-color: #06080f;
    color: #94a3b8;
    position: relative;
  }

  /* Architectural Display Typography (Linear / Vercel Tight Kerning) */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  .font-display {
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif !important;
    letter-spacing: -0.035em;
    color: #f8fafc;
    font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
  }

  /* Engineering Monospace Typography */
  code,
  kbd,
  samp,
  pre,
  .font-mono {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    letter-spacing: -0.025em;
  }

  /* High-End Obsidian Selection Highlight */
  ::selection {
    background: rgba(59, 130, 246, 0.28);
    color: #ffffff;
  }

  /* Clean Accessible Focus Ring */
  :focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
    border-radius: 8px;
  }
}

@layer utilities {
  /* Bespoke Architectural Blueprint Grid Background */
  .bg-grid {
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
                      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  /* Ultra-Lightweight Vector Matte Film-Grain Texture (0 KB Network Overhead) */
  .bg-noise {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.032'/%3E%3C/svg%3E");
  }

  .text-balance {
    text-wrap: balance;
  }

  /* Premium Human-Crafted Obsidian Studio Card (Zero AI Glowing Tacky Edges) */
  .studio-card {
    background: #0b0f19;
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.6);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .studio-card:hover {
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.8);
    transform: translateY(-2px);
  }

  /* Linear-Style Typography Mask Container */
  .mask-line {
    overflow: hidden;
    display: inline-block;
    vertical-align: top;
  }

  /* Mobile Frame Containment (Guarantees Zero Horizontal Overflow) */
  .contain-viewport {
    max-width: 100vw;
    overflow-x: hidden;
  }
}

/* Custom Sleek Scrollbar (Non-intrusive Obsidian Standard) */
::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: #06080f;
}

::-webkit-scrollbar-thumb {
  background: #1e293b;
  border-radius: 9999px;
  border: 2px solid #06080f;
}

::-webkit-scrollbar-thumb:hover {
  background: #334155;
}

/* Infinite Marquee Ticker */
@keyframes marquee {
  0% { transform: translate3d(0%, 0, 0); }
  100% { transform: translate3d(-50%, 0, 0); }
}

.animate-marquee {
  display: flex;
  width: max-content;
  animation: marquee 40s linear infinite;
  will-change: transform;
}

.animate-marquee:hover {
  animation-play-state: paused;
}

/* Smooth Dialog & Modal Transitions (Raycast Spring Physics) */
@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.97) translateY(8px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.animate-modal {
  animation: modalIn 0.24s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animate-fade {
  animation: fadeIn 0.2s ease-out forwards;
}

/* Accessibility Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}
