@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Grotesk:wght@400;500;600;700;800&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: auto;
    /* ⚡ Sticky Header Overlap Fix */
    scroll-padding-top: 5.5rem;
  }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4,
  .font-display {
    font-family: 'Space Grotesk', sans-serif !important;
    letter-spacing: -0.03em;
  }

  /* ⚡ Ultra-Sharp Cyberpunk Monospace for Metrics, Tags & Numbers */
  code,
  kbd,
  samp,
  pre,
  .font-mono {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    letter-spacing: -0.02em;
  }

  ::selection {
    background: rgba(0, 240, 255, 0.25);
    color: #00f0ff;
  }

  :focus-visible {
    outline: 2px solid theme('colors.energy.bright');
    outline-offset: 3px;
    border-radius: 4px;
  }
}

@layer utilities {
  .bg-grid {
    background-image: theme('backgroundImage.grid-fade');
    background-size: 48px 48px;
  }

  .text-balance {
    text-wrap: balance;
  }
}

/* 🏢 Smooth Infinite Marquee Animation */
@keyframes marquee {
  0% { transform: translateX(0%); }
  100% { transform: translateX(-50%); }
}

.animate-marquee {
  display: flex;
  width: max-content;
  animation: marquee 32s linear infinite;
}

.animate-marquee:hover {
  animation-play-state: paused;
}

/* Smooth Modal & Glow Keyframes */
@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(12px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.animate-modal {
  animation: modalIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.animate-fade {
  animation: fadeIn 0.25s ease-out forwards;
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}
