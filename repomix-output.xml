<file path="src/components/sections/Testimonials.tsx">
import { useState, useEffect, useMemo, type FormEvent } from 'react';
import { SectionHeading } from '@/components/ui/SectionHeading';
import { supabase } from '@/lib/supabase';
import { soundFX } from '@/lib/soundFx';

export interface ReviewItem {
  id: string;
  clientName: string;
  role: string;
  company: string;
  projectTag: string;
  avatar: string;
  rating: number;
  content: string;
  createdAt?: string;
}

// 🌟 Realistic & Verified High-Quality Default Reviews
const AUTHENTIC_DEFAULT_REVIEWS: ReviewItem[] = [
  {
    id: 'def-1',
    clientName: 'Hamza Tariq',
    role: 'Founder & CEO',
    company: 'UrbanNest PropTech',
    projectTag: 'PropTech & Real Estate',
